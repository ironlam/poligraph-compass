# Mistral AI (for question reformulation only)
MISTRAL_API_KEY=

# Vercel Cron secret (auto-set by Vercel)
CRON_SECRET=

# Umami Analytics
EXPO_PUBLIC_UMAMI_WEBSITE_ID=
